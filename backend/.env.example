# Copy to `.env` and fill in. Defaults below are safe for local development.

# --- App ---
ENVIRONMENT=development          # development | staging | production
DEBUG=true
APP_NAME=MV Automation
# Comma-separated list of allowed CORS origins (the frontend URL in prod)
CORS_ORIGINS=http://localhost:3000

# --- Database ---
# Local dev default is a SQLite file so the app runs with zero setup.
# Production (Supabase) example:
#   DATABASE_URL=postgresql+psycopg://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=sqlite+pysqlite:///./mv_local.db

# --- Supabase Auth ---
# The JWT secret from Supabase project settings (Settings > API > JWT Secret).
# Used to verify dashboard access tokens. Leave blank locally; auth tests use a fixture.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_URL=
SUPABASE_ANON_KEY=

# --- Providers (swappable; "fake" needs no network/keys) ---
GEOCODING_PROVIDER=fake          # fake | google | mapbox
GEOCODING_API_KEY=
EMAIL_PROVIDER=fake              # fake | resend | smtp
EMAIL_API_KEY=
EMAIL_FROM=quotes@example.com

# --- LLM / agent (post-quote sales assistant) ---
# Required for the agent to reach a real model; leave empty to keep it offline.
OPENAI_API_KEY=
AGENT_MODEL=gpt-5-mini
AGENT_MAX_OUTPUT_TOKENS=4096
# minimal | low | medium | high
AGENT_REASONING_EFFORT=low
AGENT_TIMEOUT_SECONDS=30

# --- Hardening ---
# Per-IP rate limiting on public endpoints (disable only for load testing).
RATE_LIMIT_ENABLED=true
# Sentry error monitoring; leave empty to disable.
SENTRY_DSN=
